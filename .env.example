# Database: Leave unset for zero-config embedded PostgreSQL (PGlite) at ./data/pglite
# Set DATABASE_URL for Supabase or external PostgreSQL (SSL enabled automatically for Supabase)
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_STORAGE_BUCKET=casefiles-private

# Security secrets (generate strong 32+ byte random strings for production)
SESSION_SECRET=dev-case-files-session-secret-change-in-production-9f8a7b6c
ASSET_SIGNING_SECRET=dev-case-files-asset-signing-secret-change-in-production-4d3e2f1a

# Private Object Storage: "local" (default ./storage/private), "supabase" (Supabase private bucket), or "s3" (AWS S3 / R2 / MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/private

# S3-compatible private object storage settings (when STORAGE_DRIVER=s3)
# S3_BUCKET=the-case-files-evidence-private
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# Signed asset URL TTL in seconds (default 900 = 15 minutes)
SIGNED_URL_TTL_SECONDS=900
